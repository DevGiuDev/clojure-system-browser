;; Polylith-style workspace configuration: paths live in aliases, so there is
;; no top-level :paths for the browser to read. Discovery follows the brick
;; conventions instead and never executes this file.
{:aliases
 {:dev {:extra-paths ["components/shop/src" "components/warehouse/src"
                      "bases/worker/src" "development/src"]
        :extra-deps {}}
  :test {:extra-paths ["components/shop/test" "components/warehouse/test"
                       "development/test"]}
  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
         :main-opts ["-e" "(require 'poly.sample.shop.components.invoice-test)"
                     "-e" "(require 'poly.sample.warehouse.components.orders-test)"
                     "-e" "(require 'poly.sample.dev.scratch-test)"
                     "-m" "nrepl.cmdline" "--bind" "127.0.0.1" "--port" "0"]}}}
