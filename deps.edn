{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        rewrite-clj/rewrite-clj {:mvn/version "1.3.59"}}
 :aliases
 {:test {:extra-paths ["test"] :main-opts ["-m" "csb.test-runner"]}
  :cli {:main-opts ["-m" "csb.cli"]}
  :desktop {:extra-paths ["apps/desktop/src"]
            :extra-deps {cljfx/cljfx {:mvn/version "1.10.363"}
                         org.fxmisc.richtext/richtextfx {:mvn/version "0.11.7"}
                         org.openjfx/javafx-controls {:mvn/version "27.0.1"}}
            :override-deps {org.openjfx/javafx-base {:mvn/version "27.0.1"}
                            org.openjfx/javafx-graphics {:mvn/version "27.0.1"}
                            org.openjfx/javafx-controls {:mvn/version "27.0.1"}
                            org.openjfx/javafx-media {:mvn/version "27.0.1"}
                            org.openjfx/javafx-web {:mvn/version "27.0.1"}}
            :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
            :main-opts ["-m" "csb.desktop-launcher"]}
  :desktop-test {:extra-paths ["test-desktop" "test-support"]
                 :jvm-opts ["-Dglass.platform=Headless" "-Dprism.order=sw"
                            "-Djavafx.cachedir=.cache/javafx"]
                 :main-opts ["-m" "csb.desktop-smoke"]}
  :tui {:extra-paths ["apps/tui/src"]
        :extra-deps {com.googlecode.lanterna/lanterna {:mvn/version "3.1.5"}}
        :main-opts ["-m" "csb.tui"]}
  :tui-test {:extra-paths ["test-tui" "test-support"] :main-opts ["-m" "csb.tui-smoke"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
